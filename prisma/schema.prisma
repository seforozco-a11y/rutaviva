generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Lugares "singulares" (playas, miradores, gastronomía, naturaleza, etc.).
// Escalable: se agregan desde el panel admin o por sugerencias de usuarios,
// sin tocar código. El campo `status` alimenta el flujo de moderación:
//   PENDING  → enviada por un usuario, esperando validación del admin
//   APPROVED → publicada en la app (visible en mapa/lista/detalle)
//   REJECTED → descartada tras revisión
model SingularPlace {
  id          String   @id @default(cuid())
  name        String
  description String
  category    String   @default("otro")
  lat         Float
  lng         Float
  address     String?
  imageUrl    String?
  tips        String?
  featured    Boolean  @default(false)
  active      Boolean  @default(true)
  status      String   @default("APPROVED") // PENDING | APPROVED | REJECTED
  source      String   @default("ADMIN") // ADMIN | USER
  suggestedBy String? // nombre del usuario que sugirió (si source = USER)
  city        String   @default("Manzanillo")
  state       String   @default("Colima")
  // true cuando imageUrl es un data URL base64: la lista pública NO transfiere
  // la imagen (era el patrón que quemó la cuota de Neon); la portada se sirve
  // por /api/images/place/[id] con caché inmutable en el CDN.
  coverInline Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  reviews Review[]
  photos  Photo[]

  @@index([category])
  @@index([active])
  @@index([status])
}

// Reseñas escritas por usuarios. Pasan por validación del admin antes de
// publicarse (status PENDING → APPROVED / REJECTED).
// Los campos flagged* alimentan el mecanismo "Reportar reseña" (requisito de
// la política de contenido UGC de Google Play): cualquier visitante puede
// reportar una reseña publicada; queda oculta para el público mientras el
// equipo RutaViva la revisa (dismiss-flag la restaura, reject la descarta).
model Review {
  id         String        @id @default(cuid())
  placeId    String
  place      SingularPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  authorName String
  rating     Int // 1..5
  comment    String
  status     String        @default("PENDING") // PENDING | APPROVED | REJECTED
  flagged    Boolean       @default(false) // marcada por un reporte de usuario
  flagReason String? // motivo opcional del reporte (máx 300 caracteres)
  flaggedAt  DateTime?
  createdAt  DateTime      @default(now())

  photos Photo[]

  @@index([placeId])
  @@index([status])
}

// Fotos: de reseñas de usuarios o de sugerencias de lugares (portada).
// Las fotos de usuarios también se validan junto con su contenido.
model Photo {
  id        String         @id @default(cuid())
  url       String // data URL (upload comprimido) o ruta /images/...
  placeId   String?
  place     SingularPlace? @relation(fields: [placeId], references: [id], onDelete: Cascade)
  reviewId  String?
  review    Review?        @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  status    String         @default("PENDING") // PENDING | APPROVED | REJECTED
  // true cuando url es un data URL base64: los JSON públicos devuelven una URL
  // ligera (/api/images/photo/[id]) en vez del base64 completo.
  inline    Boolean        @default(false)
  // Posición de la foto en la galería del lugar (0 = portada). La define el
  // equipo al editar el lugar; el orden de subida solo es el respaldo inicial.
  order     Int            @default(0)
  // true = la foto está en el "baúl" del lugar: el equipo la apartó de la
  // galería (se ve atenuada al editar) pero NUNCA se borra; se restaura con
  // un toque desde el panel y no aparece en ninguna vista pública.
  archived  Boolean        @default(false)
  createdAt DateTime       @default(now())

  @@index([placeId])
  @@index([reviewId])
}

// Registro de seguridad del login del panel (anti fuerza bruta). Nunca se
// guarda la IP en claro: solo un hash con sal del servidor (irreversible).
// Se purga automáticamente a las 48 h — coherente con el aviso de privacidad.
model AdminLoginLog {
  id        String   @id @default(cuid())
  ipHash    String // HMAC-SHA256 truncado de la IP, con sal = ADMIN_SECRET
  success   Boolean // ¿el intento fue exitoso?
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
  @@index([createdAt])
}

// Fragmentos temporales de una restauración de respaldo. Los archivos grandes
// no caben en una sola petición de Vercel (límite 4.5 MB), así que el panel
// los sube por partes: cada parte se guarda aquí y, al confirmar, se
// reconstruye el JSON completo. Se purgan al confirmar o a las 24 h.
model BackupChunk {
  id        String   @id @default(cuid())
  sessionId String // id de la subida (generado por el panel)
  seq       Int // orden del fragmento (0, 1, 2…)
  data      String // trozo de texto del respaldo (JSON)
  createdAt DateTime @default(now())

  @@unique([sessionId, seq])
  @@index([createdAt])
}

// Reportes y comentarios de los usuarios (sin cuenta necesaria):
//  - kind PLACE: "¿Información incorrecta?" en la ficha de un lugar
//    (ubicación errónea, cerrado, fotos que no corresponden, duplicado…).
//  - kind APP: "Ayuda y comentarios" en el mapa (errores, ideas, contenido).
// Motivos predefinidos (src/lib/reports.ts) + detalle libre + contacto
// opcional. placeId es SOLO referencia informativa sin FK a propósito: el
// reporte sobrevive si el lugar se elimina (placeName queda de snapshot).
model Report {
  id         String    @id @default(cuid())
  kind       String // PLACE | APP
  placeId    String?
  placeName  String?
  reason     String // slug del motivo (REPORT_REASONS)
  detail     String? // texto libre (máx 500)
  contact    String? // correo/teléfono opcional (máx 80)
  meta       String? // dispositivo/navegador auto-capturado (máx 300)
  status     String    @default("PENDING") // PENDING | RESOLVED | DISMISSED
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([status, createdAt])
}
